or:#fff;font-weight:700}\n  .step p{margin:0;font-size:14px;color:#b9b7b0}\n  @media (max-width:900px){.steps{grid-template-columns:1fr 1fr;gap:30px}}\n  @media (max-width:560px){.steps{grid-template-columns:1fr}}\n\n  /* FAQ 双栏问答 */\n  .faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 56px}\n  .qa{padding:22px 0;border-top:1px solid var(--line)}\n  .qa h3{font-size:15.5px;margin:0 0 8px;color:#fff;font-weight:600;display:flex;gap:10px}\n  .qa h3 .q{color:var(--green);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;flex:0 0 auto;padding-top:2px}\n  .qa p{margin:0;font-size:14.5px;color:#bcbab3;padding-left:24px}\n  @media (max-width:820px){.faq-grid{grid-template-columns:1fr;gap:0}}\n\n  .closing{padding:60px 0 76px;border-bottom:none}\n  .closing-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,0.85fr);gap:48px;align-items:start}\n  .closing h2{margin-bottom:16px}\n  .closing p{color:#b9b7b0;max-width:52ch;margin:0;font-size:15px}\n  .linklist{list-style:none;margin:0;padding:0;border-top:2px solid var(--green)}\n  .linklist li{border-bottom:1px solid var(--line)}\n  .linklist a{display:flex;justify-content:space-between;gap:16px;padding:14px 0;text-decoration:none;font-size:14.5px;color:#e9e7e0}\n  .linklist a span:last-child{color:var(--green);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px}\n  .linklist a:hover{color:var(--green)}\n  @media (max-width:820px){.closing-grid{grid-template-columns:1fr;gap:34px}}\n\n  footer{border-top:1px solid var(--line);padding:26px 0 36px;font-size:12.5px;color:var(--muted)}\n  footer .wrap{display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between}\n</style><header class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"brandline\">\n      <span class=\"dot\"></span>\n      <b>小鸡快跑</b>\n      <span class=\"mono\">CHICKENRUN</span>\n    </div>\n    <nav class=\"topnav\" aria-label=\"页面目录\">\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#howto\">使用说明</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <p class=\"kicker\">Subscription Reference · 方案参考</p>\n        <h1>小鸡快跑(ChickenRun) · 小鸡快跑 ChickenRun<span class=\"en\">CHICKENRUN</span></h1>\n        <p class=\"hero-lead\">\n          这一页只做一件事：把三个订阅档位的价格、流量额度、同时在线设备数与附加项，\n          放在同一张表里逐行对照。不描述速度，不承诺节点数量，\n          也不替你判断哪一档更“合适”。先看清每行写的是什么，再决定要不要选。\n        </p>\n      </div>\n\n      <aside class=\"panel\" aria-label=\"方案速览\">\n        <h2>速览 / At a Glance</h2>\n        <dl>\n          <div class=\"row\"><dt>档位数量</dt><dd class=\"mono\">3</dd></div>\n          <div class=\"row\"><dt>月付起价</dt><dd class=\"mono\">¥15 / 月</dd></div>\n          <div class=\"row\"><dt>年付起价</dt><dd class=\"mono\">¥150 / 年</dd></div>\n          <div class=\"row\"><dt>月流量区间</dt><dd class=\"mono\">100GB – 1000GB</dd></div>\n          <div class=\"row\"><dt>设备数区间</dt><dd class=\"mono\">3 – 20 台</dd></div>\n          <div class=\"row\"><dt>对照方式</dt><dd>横向表格 · 逐行比较</dd></div>\n        </dl>\n        <p class=\"note\">\n          上表数字均取自下方方案表格，两处一致。价格与额度如后续调整，以实际购买页面标注为准。\n        </p>\n      </aside>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>订阅方案对照</h2>\n        <span class=\"idx mono\">01 / PLANS</span>\n      </div>\n      <p class=\"sec-note\">\n        从左到右依次是基础版、旗舰版、团队版。每一行对应一项可比较的配置，\n        纵向读完一列即可得到该档位的完整内容。旗舰版在表中做了浅色底标记，仅用于区分，不代表推荐。\n      </p>\n\n      <div class=\"table-scroll\">\n        <table class=\"plans\">\n          \n            小鸡快跑订阅档位横向对照\n          \n          <thead>\n            <tr>\n              <th> </th>\n              <th>\n                <span class=\"plan-name\">基础版</span>\n                <span class=\"plan-price\">¥15 / 月</span>\n                <span class=\"annual\">年付 ¥150 / 年</span>\n              </th>\n              <th class=\"featured\">\n                <span class=\"plan-name\">旗舰版<span class=\"tag\">标记</span></span>\n                <span class=\"plan-price\">¥35 / 月</span>\n                <span class=\"annual\">年付 ¥350 / 年</span>\n              </th>\n              <th>\n                <span class=\"plan-name\">团队版</span>\n                <span class=\"plan-price\">¥85 / 月</span>\n                <span class=\"annual\">年付 ¥850 / 年</span>\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>计费方式</th>\n              <td>月付 / 年付</td>\n              <td class=\"featured\">月付 / 年付</td>\n              <td>月付 / 年付</td>\n            </tr>\n            <tr>\n              <th>流量额度</th>\n              <td>每月 100GB</td>\n              <td class=\"featured\">每月 300GB</td>\n              <td>每月 1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>线路与节点</th>\n              <td>普通线路节点池</td>\n              <td class=\"featured\">全节点池，含 IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体解锁</td>\n              <td class=\"featured\">全节点原生流媒体解锁</td>\n              <td>与旗舰版同项（专属节点）</td>\n            </tr>\n            <tr>\n              <th>路由配置</th>\n              <td>使用默认路由</td>\n              <td class=\"featured\">使用默认路由</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持渠道</th>\n              <td>标准工单支持</td>\n              <td class=\"featured\">7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合的比较场景</th>\n              <td>单人、少量设备、额度需求不高</td>\n              <td class=\"featured\">多人共用同一账号、需要更高额度与专线优化</td>\n              <td>小组或团队统一管理、需要定制路由与固定联系人</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"plan-foot\">\n        说明：表格中的“适合的比较场景”是对配置组合的描述性归纳，不是使用效果承诺。\n        各档位之间不存在自动升级或降级路径，切换需要按所选档位重新选择计费周期。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端</h2>\n        <span class=\"idx mono\">02 / CLIENTS</span>\n      </div>\n      <p class=\"sec-note\">\n        客户端只负责连接与配置，不改变订阅额度。以下按常见平台分组说明界面位置；\n        各客户端版本迭代较快，若菜单名称与描述不同，以你本机实际界面为准。\n      </p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <p class=\"who\">桌面端 · Desktop</p>\n          <h3>Windows / macOS</h3>\n          <p>安装后从订阅页复制配置，粘贴到客户端的订阅导入位置即可。桌面端通常支持托盘常驻与开机启动。</p>\n          <ol>\n            <li>打开客户端，进入「配置」或「订阅」面板。</li>\n            <li>粘贴订阅链接，执行导入并等待列表刷新。</li>\n            <li>在节点列表中选择一条线路，再开启系统代理。</li>\n            <li>连接后在客户端首页核对当前线路与流量统计。</li>\n          </ol>\n        </article>\n\n        <article class=\"client\">\n          <p class=\"who\">移动端 · Mobile</p>\n          <h3>iOS / Android</h3>\n          <p>移动端在导入订阅后需要授权本地代理权限，首次连接时系统会弹出确认提示，属正常流程。</p>\n          <ol>\n            <li>在应用内找到「添加订阅」并粘贴链接。</li>\n            <li>允许应用添加本地代理配置。</li>\n            <li>选择线路后点击连接，状态栏出现标识即生效。</li>\n            <li>切换网络（如从 Wi-Fi 到蜂窝）后建议重新选择一次线路。</li>\n          </ol>\n        </article>\n\n        <article class=\"client\">\n          <p class=\"who\">网络设备 · Router</p>\n          <h3>路由器与共享环境</h3>\n          <p>在路由器上配置时，整个局域网共用同一个订阅账号，因此需要按「同时在线设备」上限评估是否够用。</p>\n          <ol>\n            <li>确认路由器固件支持手动填写代理或订阅地址。</li>\n            <li>在管理后台填写订阅信息并保存。</li>\n            <li>逐台设备验证出口是否一致。</li>\n            <li>团队版可按需申请定制路由说明。</li>\n          </ol>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>使用说明</h2>\n        <span class=\"idx mono\">03 / HOW TO</span>\n      </div>\n      <p class=\"sec-note\">\n        从选择档位到完成一次连接，一共四步。每一步都可以独立回退，不涉及不可撤销的操作。\n      </p>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <h3>对照表格选档位</h3>\n          <p>先看流量额度与同时在线设备数这两行，它们决定了日常使用的上限；再看支持渠道是否符合你的沟通习惯。</p>\n        </div>\n        <div class=\"step\">\n          <h3>确定计费周期</h3>\n          <p>月付与年付对应同一档位配置，差异只在结算周期与总额。年付金额在表格第二行单独标出，便于直接换算。</p>\n        </div>\n        <div class=\"step\">\n          <h3>导入订阅</h3>\n          <p>在客户端中粘贴订阅链接并刷新节点列表。若列表为空，先检查链接是否完整复制，再检查客户端时间是否正确。</p>\n        </div>\n        <div class=\"step\">\n          <h3>核对状态</h3>\n          <p>连接后确认当前线路名称与剩余流量显示。数字与所选档位不一致时，先退出重进，再联系对应支持渠道。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <span class=\"idx mono\">04 / FAQ</span>\n      </div>\n      <p class=\"sec-note\">\n        以下问题按提问频率排列，左栏偏方案与计费，右栏偏客户端与日常使用。\n      </p>\n\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q1</span>三个档位的差别主要集中在哪些行？</h3>\n          <p>集中在流量额度、同时在线设备数、线路类型与支持渠道四行。价格随这四行同步变化，其余行多为附加项，例如团队版的定制路由。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q2</span>年付比月付便宜多少？</h3>\n          <p>按表格数字直接换算：基础版年付 ¥150 相当于 10 个月月付金额，旗舰版年付 ¥350 同样为 10 个月，团队版年付 ¥850 亦然。具体以购买页显示为准。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q3</span>“同时在线设备”是怎么计算的？</h3>\n          <p>指同一时刻保持连接状态的设备数量。关闭客户端或断开连接后即释放名额。在路由器上配置时，整个局域网按共享同一账号计算。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q4</span>当月流量用完了会怎样？</h3>\n          <p>额度按自然月计。页面不承诺额外的补偿机制，也不描述超出后的处理细节；如需了解，请通过对应档位的支持渠道确认。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q5</span>可以在多个平台同时使用同一账号吗？</h3>\n          <p>可以，前提是不超过该档位的设备数上限。桌面端、移动端与路由器共用同一份名额，因此建议先统计常连设备再选档位。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q6</span>导入订阅后节点列表是空的，先查什么？</h3>\n          <p>依次检查三项：订阅链接是否被截断、客户端与订阅是否在同一网络环境、设备系统时间是否准确。多数空白列表由链接不完整或时间偏差导致。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q7</span>换设备或重装系统后需要重新购买吗？</h3>\n          <p>不需要重新选择档位。在新设备上重新导入同一份订阅即可，只要同时在线的设备数不超出所选档位上限。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q8</span>团队版的定制路由需要准备什么信息？</h3>\n          <p>至少需要说明使用场景、需要区分的网段或设备范围，以及预计同时在线的终端数量。这些信息由专属客户经理对接收集。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q9</span>页面上写的线路优化，能保证游戏延迟吗？</h3>\n          <p>不能。表格描述的是线路类型与优化方向，实际延迟受本地网络、运营商与国际链路共同影响，页面不作数值承诺。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q10</span>价格或配置调整后，这个页面会同步吗？</h3>\n          <p>页面内容是对外说明的一部分，配置变化时应保持与购买页一致。若发现两处不一致，请以购买页标注为准，并通过支持渠道反馈。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"closing\">\n    <div class=\"wrap closing-grid\">\n      <div>\n        <span class=\"idx mono\">05 / NEXT</span>\n        <h2>看完表格之后</h2>\n        <p>\n          如果你的需求能被表格中的某一行说清，那就按那一行选。\n          如果还有说不清的部分，先确认它属于额度、设备数、线路类型还是支持渠道中的哪一类，\n          再带着这个具体问题去找对应档位的支持渠道，通常比笼统提问更快得到答复。\n        </p>\n      </div>\n      <ul class=\"linklist\">\n        <li><a href=\"#plans\"><span>回到订阅方案对照表</span><span>01</span></a></li>\n        <li><a href=\"#clients\"><span>查看客户端配置说明</span><span>02</span></a></li>\n        <li><a href=\"#howto\"><span>阅读四步使用说明</span><span>03</span></a></li>\n        <li><a href=\"#faq\"><span>浏览常见问题</span><span>04</span></a></li>\n      </ul>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>小鸡快跑 ChickenRun · 订阅方案与使用说明</span>\n    <span class=\"mono\">页面所述配置与价格以购买页实际标注为准</span>\n  </div>\n</footer>",
